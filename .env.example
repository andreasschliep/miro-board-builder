# Copy to .env and fill in what you need. Never commit .env.
# Not needed for `validate`, `info` or `build --dry-run`.

# Miro access token with boards:read and boards:write
MIRO_ACCESS_TOKEN=your-miro-access-token
# Default target board (or pass --board-id)
MIRO_BOARD_ID=
# Team for `build --new-board` (optional)
MIRO_TEAM_ID=
# Optional tuning
MIRO_HTTP_TIMEOUT_MS=20000
MIRO_MAX_RETRIES=4

# Only for `optimize`
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional; default is claude-opus-5-5
ANTHROPIC_MODEL=
